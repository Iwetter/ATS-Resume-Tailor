# Copy to .env (git-ignored) and edit. Never commit real values.
# Every setting has a safe default; real submission is OFF unless enabled here.

# ---- Storage -------------------------------------------------------------
# HUNTER_DB=/app/data/hunter.sqlite3      # set by docker-compose; local default is data/hunter.sqlite3

# ---- Discovery worker ----------------------------------------------------
SCAN_INTERVAL_SECONDS=720                  # 12 minutes; minimum 300
SCAN_JITTER_SECONDS=60
LISTING_CACHE_SECONDS=540                  # keep below the scan interval so each scan is fresh
DETAIL_CACHE_SECONDS=21600                 # unchanged job details; refreshed early when a listing changes
WORKDAY_SCAN_INTERVAL_SECONDS=3600         # large public sitemaps: hourly
SCAN_LEASE_MINUTES=30
PUBLICATION_WINDOW_DAYS=7
HEALTH_PORT=0                              # >0 also serves /healthz over HTTP
LOG_LEVEL=INFO

# ---- Application safety --------------------------------------------------
AUTOAPPLY_ALLOW_REAL_SUBMISSION=false      # keep false until profile, employer flows and tests are reviewed
AUTOAPPLY_EMERGENCY_STOP=false             # true = global stop (also: touch data/STOP, or the dashboard button)
AUTOAPPLY_MAX_PER_DAY=5
AUTOAPPLY_MAX_PER_COMPANY_PER_DAY=1
AUTOAPPLY_MAX_PER_COMPANY_TOTAL=3
AUTOAPPLY_MIN_FIT_REVIEW=45
AUTOAPPLY_MIN_FIT_AUTO=60
AUTOAPPLY_TRUST_MODEL_MAPPINGS=false       # Claude question→field mappings always need review when false
AUTOAPPLY_AUTO_ACCEPT_VALIDATED_REWRITES=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=          # only to use a system Chromium

# ---- Claude (official Anthropic SDK) -------------------------------------
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=                         # or ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_OUTPUT_TOKENS=1800
CLAUDE_MAX_INPUT_TOKENS=12000
CLAUDE_MAX_RETRIES=2
CLAUDE_DAILY_USD_LIMIT=2.00
CLAUDE_MONTHLY_USD_LIMIT=20.00
# Required for spend enforcement: copy current prices for CLAUDE_MODEL from your Anthropic console.
CLAUDE_INPUT_USD_PER_MTOK=
CLAUDE_OUTPUT_USD_PER_MTOK=
